{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // catalogue.spec.ts imports scripts/build-catalog.mjs so the generator
    // is tested against the same query the endpoint uses. Types are inferred
    // from the .mjs; checkJs stays off, so the script itself is not linted here.
    "allowJs": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
